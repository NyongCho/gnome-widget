{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [],
    "resolveJsonModule": true
  },
  "include": [
    "src/types.ts",
    "src/shared/**/*.ts"
  ]
}
