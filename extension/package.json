{
  "name": "liquid-widgets-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.gnome.json",
    "build": "node scripts/build.mjs",
    "generate": "node scripts/generate-validators.mjs",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate"
  },
  "devDependencies": {
    "@girs/gnome-shell": "50.0.4",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
