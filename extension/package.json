{
  "name": "liquid-widgets-extension",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.gnome.json && tsc -p tsconfig.prefs.json && tsc -p tsconfig.worker.json",
    "build": "node scripts/build.mjs",
    "generate": "node scripts/generate-validators.mjs",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate",
    "test:calendar": "python3 ../scripts/test-calendar-parity.py --engine gjs",
    "build:gjs": "node scripts/build.mjs --edition gjs"
  },
  "devDependencies": {
    "@girs/gnome-shell": "50.0.4",
    "@girs/secret-1": "4.9.0",
    "@girs/soup-3.0": "4.9.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "ical.js": "2.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
