          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "enum": [
                "NETWORK_ERROR",
                "INVALID_DATA",
                "PAYLOAD_TOO_LARGE",
                "EXPANSION_LIMIT",
                "UNSUPPORTED_CALENDAR",
                "UNKNOWN_TIME_ZONE",
                "KEYRING_LOCKED",
                "SECRET_DELETION_FAILED",
                "AUTH_ERROR",
                "RATE_LIMITED",
                "NO_PLAYER",
                "NO_INTERFACE",
                "SERVICE_UNAVAILABLE",
                "INTERNAL_ERROR"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "stale"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/CalendarData"
              },
              "updatedAt": {
                "type": "string",
                "maxLength": 64,
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unconfigured",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "null"
              },
              "updatedAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "unconfigured",
                  "loading"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "errorCode": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "errorCode": {
                "enum": [
                  "NETWORK_ERROR",
                  "INVALID_DATA",
                  "PAYLOAD_TOO_LARGE",
                  "EXPANSION_LIMIT",
                  "UNSUPPORTED_CALENDAR",
                  "UNKNOWN_TIME_ZONE",
                  "KEYRING_LOCKED",
                  "SECRET_DELETION_FAILED",
                  "AUTH_ERROR",
                  "RATE_LIMITED",
                  "NO_PLAYER",
                  "NO_INTERFACE",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ]
              }
            }
          }
        }
      ]
    },
