{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "revisions",
    "calendar",
    "weather",
    "system",
    "network",
    "media"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "weather",
        "system",
        "network",
        "media"
      ],
      "properties": {
        "calendar": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "weather": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "system": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "network": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "media": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "calendar": {
      "$ref": "#/$defs/CalendarState"
    },
    "weather": {
      "$ref": "#/$defs/WeatherState"
    },
    "system": {
      "$ref": "#/$defs/SystemState"
    },
    "network": {
      "$ref": "#/$defs/NetworkState"
    },
    "media": {
      "$ref": "#/$defs/MediaState"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liquid-widgets:snapshot:v1",
  "$defs": {
    "CalendarContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "timeZone",
        "weekStart"
      ],
      "properties": {
        "month": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "timeZone": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "weekStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "CalendarEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "occurrenceKey",
        "title",
        "start",
        "end",
        "allDay"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 2048,
          "minLength": 1
        },
        "occurrenceKey": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "title": {
          "type": "string",
          "maxLength": 4096
        },
        "start": {
          "type": "string",
          "maxLength": 64
        },
        "end": {
          "type": "string",
          "maxLength": 64
        },
        "allDay": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allDay": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 10,
                "format": "date"
              },
              "end": {
                "type": "string",
                "maxLength": 10,
                "format": "date"
              }
            }
          },
          "else": {
            "properties": {
              "start": {
                "type": "string",
                "maxLength": 64,
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "maxLength": 64,
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "CalendarData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "timeZone",
        "weekStart",
        "events"
      ],
      "properties": {
        "month": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "timeZone": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "weekStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CalendarEvent"
          },
          "maxItems": 10000
        }
      }
    },
    "WeatherLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "latitude",
        "longitude",
