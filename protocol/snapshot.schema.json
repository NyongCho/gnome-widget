    "CalendarState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceId",
        "updatedAt",
        "data",
        "errorCode"
      ],
      "properties": {
        "status": {
          "enum": [
            "loading",
            "ok",
            "stale",
            "unconfigured",
            "unavailable"
          ]
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalendarData"
