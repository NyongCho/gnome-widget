      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "label": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timeZone": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        }
      }
    },
    "WeatherData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "timeZone",
        "current",
        "hourly",
        "attributionUrl"
      ],
      "properties": {
        "location": {
          "type": "string",
          "maxLength": 512
        },
        "timeZone": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperatureC",
            "code"
          ],
          "properties": {
            "temperatureC": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "hourly": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "temperatureC",
              "precipitationProbability"
            ],
            "properties": {
              "at": {
                "type": "string",
                "maxLength": 64,
                "format": "date-time"
              },
              "temperatureC": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "precipitationProbability": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 6
        },
        "attributionUrl": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://"
        }
      }
    },
    "SystemData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuPercent",
        "memoryUsedBytes",
        "memoryTotalBytes",
        "temperatureC"
      ],
      "properties": {
        "cpuPercent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
