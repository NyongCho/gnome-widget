              "at": {
                "type": "string",
                "maxLength": 64,
                "format": "date-time"
              },
              "rx": {
                "type": "number",
                "minimum": 0
              },
              "tx": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "maxItems": 60
        }
      }
    },
    "MediaData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player",
        "status",
        "title",
        "artist",
        "artUri"
