{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "calendar",
    "weather",
    "networkInterface"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "format": "uuid"
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "enabled",
        "deletionPending"
      ],
      "properties": {
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "deletionPending": {
          "type": "boolean"
        }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "location"
      ],
      "properties": {
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "urn:liquid-widgets:snapshot:v1#/$defs/WeatherLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "networkInterface": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^/\\s\\x00-\\x1f]+$"
    }
  },
  "$id": "urn:liquid-widgets:data-config:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
