#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -d "$task_root/.tools/cargo" ]; then
    export CARGO_HOME="$task_root/.tools/cargo"
    export RUSTUP_HOME="$task_root/.tools/rustup"
    PATH="$CARGO_HOME/bin:$PATH"
fi
if [ -d "$task_root/.tools/node/bin" ]; then
    PATH="$task_root/.tools/node/bin:$PATH"
fi
if [ -x "$task_root/.tools/bin/cc" ]; then
    PATH="$task_root/.tools/bin:$PATH"
    export CC="$task_root/.tools/bin/cc"
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="$CC"
    export PKG_CONFIG_PATH="$task_root/.tools/sysroot/usr/lib/x86_64-linux-gnu/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export PKG_CONFIG_SYSROOT_DIR="$task_root/.tools/sysroot"
fi
export PATH
if [ "$#" -eq 0 ]; then
    printf '%s\n' 'Usage: ./scripts/dev <command> [arguments...]' >&2
    exit 2
fi
exec "$@"
